    "age__age",
    "categorical__itch_FALSE",
    "categorical__itch_TRUE",
    "categorical__grew_FALSE",
    "categorical__grew_TRUE",
    "categorical__grew_UNK",
    "categorical__hurt_FALSE",
    "categorical__hurt_TRUE",
    "categorical__changed_FALSE",
    "categorical__changed_TRUE",
    "categorical__changed_UNK",
    "categorical__bleed_FALSE",
    "categorical__bleed_TRUE",
    "categorical__elevation_FALSE",
    "categorical__elevation_TRUE",
    "categorical__region_ABDOMEN",
    "categorical__region_ARM",
    "categorical__region_BACK",
    "categorical__region_CHEST",
    "categorical__region_EAR",
    "categorical__region_FACE",
    "categorical__region_FOOT",
    "categorical__region_FOREARM",
    "categorical__region_HAND",
    "categorical__region_LIP",
    "categorical__region_NECK",
    "categorical__region_NOSE",
    "categorical__region_SCALP",
    "categorical__region_THIGH"
